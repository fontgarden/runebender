/target
.DS_Store

# Local worktrees
.worktrees/

# Images: screenshots and tracing images placed in font sources stay local.
# Test fixtures may keep reference images; add any other image with `git add -f`.
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.heic
*.tif
*.tiff
!/tests/fixtures/**

# Trained neural font versions beside a .nufo source
*.models/

# Source artwork used to build the macOS application icon.
!/assets/icons/runebender.png

# Icons of the installable browser app and the Steam Deck shortcut art.
!/web/icons/*.png
!/steamdeck/art/*.png

# Python packaging helper caches.
__pycache__/
*.py[cod]
